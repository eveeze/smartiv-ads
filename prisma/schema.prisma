// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// ENUMS
// --------------------------------------

enum Role {
  SUPER_ADMIN
  ADVERTISER
  PROPERTY_OPERATOR
}

enum PropertyType {
  HOTEL
  HOSPITAL
  APARTMENT
  VILLA
  RESORT
  MALL
  OFFICE_TOWER
  OTHER
}

enum PropertyClass {
  BUDGET
  STANDARD
  PREMIUM
  LUXURY
}

enum ScreenStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum ScreenOrientation {
  LANDSCAPE
  PORTRAIT
}

enum AdSlot {
  SCREENSAVER
  INFO_SLIDER
  APP_PROMOTION
  LEISURE_CULINARY
  LEISURE_TOURISM
  LEISURE_GIFT
  WELCOME_GREETING
  BACKGROUND
}

enum RoomCategory {
  STANDARD
  DELUXE
  SUITE
  VIP
  VVIP
  PRESIDENTIAL
  LOBBY
  WAITING_ROOM
  RESTAURANT
  HALLWAY
  ELEVATOR_HALL
  WARD_CLASS_1
  WARD_CLASS_2
  WARD_CLASS_3
  ICU
  ER
  POLYCLINIC
  NURSE_STATION
  LIVING_ROOM
  MASTER_BEDROOM
  KITCHEN_AREA
  PRIVATE_POOL
  OTHER
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  COMPLETED
  PAUSED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum TransactionType {
  DEPOSIT
  SPEND
  REFUND
  WITHDRAWAL
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

// [NEW] Enum untuk Paket Durasi Campaign
enum DurationPackage {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

// --------------------------------------
// MODELS
// --------------------------------------

model User {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  password             String
  name                 String?
  phone                String?
  role                 Role      @default(ADVERTISER)
  isActive             Boolean   @default(true)
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet    Wallet?
  campaigns Campaign[]
  logs      AuditLog[]
  media     Media[]

  propertyId Int?
  property   Property? @relation(fields: [propertyId], references: [id])

  @@map("users")
}

model Wallet {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id])
  balance       BigInt   @default(0)
  frozenBalance BigInt   @default(0)
  updatedAt     DateTime @updatedAt

  transactions       Transaction[]
  withdrawalRequests WithdrawalRequest[]

  @@map("wallets")
}

model Transaction {
  id            Int               @id @default(autoincrement())
  walletId      Int
  wallet        Wallet            @relation(fields: [walletId], references: [id])
  amount        BigInt
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  referenceCode String?           @unique
  paymentToken  String?
  paymentUrl    String?
  description   String?
  createdAt     DateTime          @default(now())

  @@map("transactions")
}

model WithdrawalRequest {
  id          Int              @id @default(autoincrement())
  walletId    Int
  wallet      Wallet           @relation(fields: [walletId], references: [id])
  amount      BigInt
  bankName    String
  accountNo   String
  accountName String
  status      WithdrawalStatus @default(PENDING)
  adminNote   String?
  approvedBy  Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("withdrawal_requests")
}

model Property {
  id             Int           @id @default(autoincrement())
  name           String
  type           PropertyType  @default(HOTEL)
  classification PropertyClass @default(STANDARD)

  smartivId   Int?    @unique
  smartivCode String? @unique

  baseColor   String?
  activeColor String?
  logoUrl     String?

  address String?
  city    String?

  // [NEW] Fields untuk Timezone & Region
  timezone String  @default("Asia/Jakarta") // e.g. "Asia/Makassar"
  region   String? // e.g. "Bali", "Jabodetabek"

  enabledSlots AdSlot[] @default([SCREENSAVER])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  screens   Screen[]
  operators User[]
  rateCards RateCard[]
  campaigns Campaign[]

  @@map("properties")
}

model Screen {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])

  name        String
  code        String            @unique
  resolution  String?
  orientation ScreenOrientation @default(LANDSCAPE)
  ipAddress   String?

  roomCategory RoomCategory @default(STANDARD)

  status   ScreenStatus @default(ONLINE)
  lastPing DateTime?

  priceOverride BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns   Campaign[]
  impressions ImpressionLog[]

  @@map("screens")
}

model RateCard {
  id         Int       @id @default(autoincrement())
  propertyId Int?
  property   Property? @relation(fields: [propertyId], references: [id])

  classification PropertyClass?
  targetSlot     AdSlot?

  // [NEW] Support Paket Harga (Daily, Weekly, Monthly)
  pricePerDay   BigInt
  pricePerWeek  BigInt?
  pricePerMonth BigInt?

  currency String @default("IDR")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("rate_cards")
}

model Campaign {
  id           Int  @id @default(autoincrement())
  advertiserId Int
  advertiser   User @relation(fields: [advertiserId], references: [id])

  propertyId Int?
  property   Property? @relation(fields: [propertyId], references: [id])

  name      String
  startDate DateTime
  endDate   DateTime
  totalCost BigInt
  status    CampaignStatus @default(DRAFT)

  // [NEW] Fields untuk Logika Baru Campaign
  targetSlot      AdSlot          @default(SCREENSAVER)
  durationPackage DurationPackage @default(CUSTOM)

  rejectionReason String?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  screens     Screen[]
  items       CampaignItem[]
  impressions ImpressionLog[]

  @@map("campaigns")
}

model CampaignItem {
  id         Int      @id @default(autoincrement())
  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  mediaId Int
  media   Media @relation(fields: [mediaId], references: [id])

  targetRoomCategory RoomCategory[]
  targetSlot         AdSlot

  durationSec Int @default(15)

  // [NEW] Field untuk interaksi
  actionUrl String?

  createdAt DateTime @default(now())

  @@map("campaign_items")
}

model Media {
  id         Int  @id @default(autoincrement())
  uploaderId Int
  uploader   User @relation(fields: [uploaderId], references: [id])

  filename     String
  originalName String
  mimeType     String
  size         Int
  type         MediaType

  // [NEW] Metadata Media
  title       String?
  description String? @db.Text
  actionUrl   String? // Default action URL jika tidak di-override di CampaignItem

  url          String
  thumbnailUrl String?
  hlsUrl       String?
  isTranscoded Boolean @default(false)

  status          ApprovalStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignItems CampaignItem[]

  @@map("media")
}

model ImpressionLog {
  id         BigInt   @id @default(autoincrement())
  screenId   Int
  screen     Screen   @relation(fields: [screenId], references: [id])
  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  timestamp  DateTime @default(now())
  duration   Int

  @@map("impression_logs")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@map("audit_logs")
}