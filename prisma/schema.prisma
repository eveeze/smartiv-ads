// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// ENUMS·
// --------------------------------------

enum Role {
  SUPER_ADMIN
  ADVERTISER
  PROPERTY_OPERATOR
}

enum PropertyType {
  HOTEL
  HOSPITAL      // Rumah Sakit
  APARTMENT
  VILLA
  RESORT
  MALL
  OFFICE_TOWER
  OTHER
}

// Klasifikasi untuk menentukan "Base Rate" harga iklan
enum PropertyClass {
  // Hotel: Bintang 1-2 | RS: Kelas C/D | Mall: Grade C
  BUDGET 
  
  // Hotel: Bintang 3 | RS: Kelas B | Mall: Grade B
  STANDARD 
  
  // Hotel: Bintang 4 | RS: Kelas A (Swasta Premium) | Mall: Grade A
  PREMIUM 
  
  // Hotel: Bintang 5/Luxury | RS: International/VIP Only
  LUXURY 
}

enum ScreenStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum ScreenOrientation {
  LANDSCAPE
  PORTRAIT
}

// Slot Iklan (Sesuai Menu Aplikasi SmartIV di TV)
enum AdSlot {
  SCREENSAVER       // Idle Mode
  INFO_SLIDER       // Running Text / Banner Bawah
  APP_PROMOTION     // Pop-up Apps
  
  // Menu Sections (Bisa dipakai untuk Health Info di RS)
  LEISURE_CULINARY  
  LEISURE_TOURISM   
  LEISURE_GIFT
  
  // Other Placements
  WELCOME_GREETING  // Saat Tamu/Pasien Check-in
  BACKGROUND        // Wallpaper Menu Utama
}

// Kategori Ruangan (Diperluas untuk RS & Villa)
enum RoomCategory {
  // --- HOTEL / UMUM ---
  STANDARD
  DELUXE
  SUITE
  
  // --- VIP SECTOR (Hotel/RS) ---
  VIP
  VVIP
  PRESIDENTIAL

  // --- PUBLIC AREA ---
  LOBBY           // Lobi Utama
  WAITING_ROOM    // Ruang Tunggu (Poli/Keluarga)
  RESTAURANT      // Kantin / Resto
  HALLWAY         // Lorong / Koridor
  ELEVATOR_HALL   // Depan Lift

  // --- HOSPITAL SPECIFIC ---
  WARD_CLASS_1    // Rawat Inap Kelas 1
  WARD_CLASS_2    // Rawat Inap Kelas 2
  WARD_CLASS_3    // Rawat Inap Kelas 3
  ICU             // Intensive Care Unit (Biasanya untuk keluarga penunggu)
  ER              // Emergency Room / IGD
  POLYCLINIC      // Poli Rawat Jalan
  NURSE_STATION   // Konter Perawat

  // --- VILLA / APARTMENT SPECIFIC ---
  LIVING_ROOM     // Ruang Tengah
  MASTER_BEDROOM  // Kamar Utama
  KITCHEN_AREA    // Area Dapur/Makan
  PRIVATE_POOL    // Area Kolam Renang Privat

  OTHER
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  COMPLETED
  PAUSED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum TransactionType {
  DEPOSIT
  SPEND
  REFUND
  WITHDRAWAL
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

// --------------------------------------
// MODELS
// --------------------------------------

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  phone     String?
  role      Role     @default(ADVERTISER)
  isActive  Boolean  @default(true)
  passwordResetToken   String?   @unique  
  passwordResetExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet    Wallet?
  campaigns Campaign[]
  logs      AuditLog[]
  media     Media[]

  // Jika user adalah Property Operator (RS Admin / Hotel Admin)
  propertyId Int?
  property   Property? @relation(fields: [propertyId], references: [id])

  @@map("users")
}

model Wallet {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id])
  
  balance       BigInt   @default(0)
  frozenBalance BigInt   @default(0)
  
  updatedAt     DateTime @updatedAt

  transactions       Transaction[]
  withdrawalRequests WithdrawalRequest[]

  @@map("wallets")
}

model Transaction {
  id            Int               @id @default(autoincrement())
  walletId      Int
  wallet        Wallet            @relation(fields: [walletId], references: [id])
  amount        BigInt
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  
  referenceCode String?           @unique 
  paymentToken  String?
  paymentUrl    String?

  description   String?
  createdAt     DateTime          @default(now())

  @@map("transactions")
}

model WithdrawalRequest {
  id          Int              @id @default(autoincrement())
  walletId    Int
  wallet      Wallet           @relation(fields: [walletId], references: [id])
  
  amount      BigInt
  bankName    String
  accountNo   String
  accountName String
  
  status      WithdrawalStatus @default(PENDING)
  
  adminNote   String?
  approvedBy  Int?
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("withdrawal_requests")
}

model Property {
  id             Int           @id @default(autoincrement())
  
  name           String        // e.g., "RS Sentra Medika", "Villa Kayu Manis"
  type           PropertyType  @default(HOTEL)
  classification PropertyClass @default(STANDARD) // Grade A/B/C or Stars

  // --- Sinkronisasi SmartIV Core ---
  smartivId      Int?          @unique 
  smartivCode    String?       @unique 
  
  // --- Branding ---
  baseColor      String?       
  activeColor    String?       
  logoUrl        String?       

  // --- Lokasi & Config ---
  address        String?
  city           String?
  
  enabledSlots   AdSlot[]      @default([SCREENSAVER])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  screens   Screen[]
  operators User[]
  rateCards RateCard[]
  campaigns Campaign[]

  @@map("properties")
}

model Screen {
  id         Int               @id @default(autoincrement())
  propertyId Int
  property   Property          @relation(fields: [propertyId], references: [id])

  name       String   // e.g., "TV R.Inap 305", "TV Lobby Poli Anak"
  code       String   @unique // MAC Address
  
  resolution  String?
  orientation ScreenOrientation @default(LANDSCAPE)
  ipAddress   String?
  
  // Penentuan lokasi layar lebih spesifik (Penting untuk RS/Villa)
  roomCategory RoomCategory     @default(STANDARD)

  status      ScreenStatus      @default(ONLINE)
  lastPing    DateTime?

  priceOverride BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns   Campaign[]
  impressions ImpressionLog[]

  @@map("screens")
}

model RateCard {
  id             Int            @id @default(autoincrement())
  propertyId     Int?
  property       Property?      @relation(fields: [propertyId], references: [id])

  // Harga dasar bisa berdasarkan Kelas Properti (misal: RS Tipe A vs Tipe C)
  classification PropertyClass?
  
  targetSlot     AdSlot? 

  pricePerDay BigInt
  currency    String @default("IDR")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("rate_cards")
}

model Campaign {
  id           Int            @id @default(autoincrement())
  advertiserId Int
  advertiser   User           @relation(fields: [advertiserId], references: [id])

  propertyId   Int?
  property     Property?      @relation(fields: [propertyId], references: [id])

  name         String
  startDate    DateTime
  endDate      DateTime
  totalCost    BigInt
  status       CampaignStatus @default(DRAFT)

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  screens     Screen[]
  items       CampaignItem[]
  impressions ImpressionLog[]

  @@map("campaigns")
}

model CampaignItem {
  id                 Int            @id @default(autoincrement())
  campaignId         Int
  campaign           Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  mediaId            Int
  media              Media          @relation(fields: [mediaId], references: [id])

  // Target lebih fleksibel (bisa pilih WARD_CLASS_1, VIP, atau LOBBY)
  targetRoomCategory RoomCategory[]
  
  targetSlot         AdSlot

  durationSec Int @default(15)

  createdAt DateTime @default(now())

  @@map("campaign_items")
}

model Media {
  id             Int            @id @default(autoincrement())
  uploaderId     Int
  uploader       User           @relation(fields: [uploaderId], references: [id])

  filename       String
  originalName   String
  mimeType       String
  size           Int
  type           MediaType

  url            String
  thumbnailUrl   String?

  hlsUrl         String?
  isTranscoded   Boolean        @default(false)

  status          ApprovalStatus @default(PENDING)
  rejectionReason String?        
  reviewedAt      DateTime?      
  reviewedBy      Int?           

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaignItems CampaignItem[]

  @@map("media")
}

model ImpressionLog {
  id         BigInt   @id @default(autoincrement())
  screenId   Int
  screen     Screen   @relation(fields: [screenId], references: [id])

  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  timestamp  DateTime @default(now())
  duration   Int

  @@map("impression_logs")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@map("audit_logs")
}